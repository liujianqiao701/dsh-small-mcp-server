{
  "name": "dsh-small-mcp-server",
  "version": "0.2.2",
  "description": "MCP server manager in the DSH settings panel: list, add, edit, remove and toggle the dsh-mcp-client entries held by the loader. Toggling applies immediately; every other change is saved as a draft and hot-reloaded, with unsaved drafts never committed behind your back.",
  "type": "module",
  "license": "MIT",
  "author": "liujianqiao701 (https://github.com/liujianqiao701)",
  "contributors": [
    "anonymous authors of the original dsh-small-mcp-server v0.1.x (upstream)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liujianqiao701/dsh-small-mcp-server.git"
  },
  "homepage": "https://github.com/liujianqiao701/dsh-small-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/liujianqiao701/dsh-small-mcp-server/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "settings"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./lib/types/typert.d.ts",
      "default": "./lib/typert.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "PORTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1 <0.3.0-0"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.1 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^4.0.0"
  }
}
